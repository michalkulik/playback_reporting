<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- One build per supported server runtime:
         net9.0  -> Jellyfin 10.11.x
         net10.0 -> Jellyfin 12.x -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.PlaybackReporting</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PlaybackReporting</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Needed so build.sh can pick up third-party runtime dependencies
         (SQLitePCL.pretty.dll) to ship inside the plugin zip. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Pages\**\*" />
    <None Remove="thumb.png" />
    <EmbeddedResource Include="Pages\**\*" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SQLitePCL.pretty.netstandard" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Data" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.0.0" />
  </ItemGroup>

</Project>
